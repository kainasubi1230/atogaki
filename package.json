{
  "name": "machine",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "clean:web": "rm -rf web/.next web/.next-dev",
    "dev": "npm run dev --workspace web",
    "dev:clean": "npm run clean:web && npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace web",
    "lint": "npm run lint --workspace web"
  }
}
